{
    "models": {
        "denoiser": {
            "name": "DiffusionForcingTemporalSSFlowModel",
            "args": {
                "resolution": 16,
                "in_channels": 8,
                "out_channels": 8,
                "model_channels": 1024,
                "cond_channels": 1024,
                "num_blocks": 24,
                "num_heads": 16,
                "mlp_ratio": 4,
                "patch_size": 1,
                "pe_mode": "ape",
                "qk_rms_norm": true,
                "use_fp16": true,
                "use_checkpoint": false,
                "window_size": 3,
                "trainable_scope": "self_attn",
                "pretrained_base": "microsoft/TRELLIS-image-large/ckpts/ss_flow_img_dit_L_16l8_fp16"
            }
        }
    },
    "dataset": {
        "name": "TemporalSS",
        "args": {
            "image_size": 518,
            "window_size": 3,
            "val_num_scenes": 20,
            "val_num_frames": 12,
            "num_cond_views": 6,
            "front_view_prob": 1.0,
            "pretrained_ss_dec": "microsoft/TRELLIS-image-large/ckpts/ss_dec_conv3d_16l8_fp16"
        }
    },
    "trainer": {
        "name": "DiffusionForcingSSImageConditionedTrainer",
        "args": {
            "max_steps": 200000,
            "batch_size_per_gpu": 8,
            "batch_split": 2,
            "window_size": 3,
            "independent_t": true,
            "cfg_strength": 3.0,
            "snapshot_steps": 50,
            "rescale_t": 3.0,
            "cfg_interval": [0.5, 1.0],
            "snapshot_modes": ["ar_kvcache"],
            "optimizer": {
                "name": "AdamW",
                "args": {
                    "lr": 0.0001,
                    "weight_decay": 0.0
                }
            },
            "ema_rate": [
                0.9999
            ],
            "fp16_mode": "inflat_all",
            "fp16_scale_growth": 0.001,
            "grad_clip": {
                "name": "AdaptiveGradClipper",
                "args": {
                    "max_norm": 1.0,
                    "clip_percentile": 95
                }
            },
            "i_log": 10,
            "i_print": 100,
            "i_sample": 5000,
            "i_save": 5000,
            "p_uncond": 0.1,
            "t_schedule": {
                "name": "uniform"
            },
            "sigma_min": 1e-05,
            "image_cond_model": "dinov2_vitl14_reg"
        }
    }
}
